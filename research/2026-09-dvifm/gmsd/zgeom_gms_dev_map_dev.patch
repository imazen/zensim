+    /// GMSD lane: the 24 GMS and 96 map-deviation tail columns leave the
+    /// 228 surface bit-identical, are finite, and read as "no damage" on
+    /// an identical pair: GMS std exactly 0 and mean exactly 1 (f64, no
+    /// FMA), the `art/det/mse` map spreads exactly 0. The `sd` map is the
+    /// fused SSIM kernel's own f32/FMA output, which is NOT exactly 0 on an
+    /// identical pair (measured 3.65e-5 spread at 96×80 — the same residue
+    /// that makes zensim short-circuit identity at its API), so it is held
+    /// to a bound instead of to zero.
+    #[test]
+    fn gms_and_map_dev_tails() {
+        let (w, h) = (96usize, 80usize);
+        let (s, d) = pair(w, h);
+        let (rs, rd) = (RgbSlice::new(&s, w, h), RgbSlice::new(&d, w, h));
+        let base = crate::research::extract(
+            &zgeom_req(spec(PyramidKernel::Box2, PoolMode::Global)),
+            &rs,
+            &rd,
+        )
+        .expect("base")
+        .into_values();
+        let mut sp = spec(PyramidKernel::Box2, PoolMode::Global);
+        sp.gms_dev = true;
+        sp.map_dev = true;
+        assert_eq!(sp.emit_width(), 228 + 24 + 96);
+        let wide = crate::research::extract(&zgeom_req(sp.clone()), &rs, &rd)
+            .expect("wide")
+            .into_values();
+        assert_eq!(wide.len(), 228 + 24 + 96);
+        for i in 0..228 {
+            assert_eq!(base[i].to_bits(), wide[i].to_bits(), "f{i}");
+        }
+        assert!(wide.iter().all(|v| v.is_finite()));
+        assert!(wide[228..240].iter().any(|&v| v > 0.0), "distorted GMS std");
+        let ident = crate::research::extract(&zgeom_req(sp), &rs, &rs)
+            .expect("identity")
+            .into_values();
+        for c in 0..12 {
+            assert_eq!(ident[228 + c], 0.0, "gms std cell {c}");
+            assert_eq!(ident[240 + c], 1.0, "gms mean cell {c}");
+            for m in 1..4 {
+                assert_eq!(ident[252 + c * 8 + m], 0.0, "map {m} cell {c}");
+            }
+            assert!(ident[252 + c * 8] < 1e-3, "sd spread cell {c}");
+        }
+    }
+
