     /// `blockiness_sparse(src, dst) / n` — the slot-25 value for this
     /// cell (only filled when `spec.blockiness`).
     blockiness: f64,
+    /// GMSD lane: `(std, mean)` of this cell's GMS map (`spec.gms_dev`).
+    gms: (f64, f64),
+    /// GMSD lane: sample std of each of the eight maps (`spec.map_dev`).
+    map_dev: [f64; 8],
+}
+
+/// GMSD's similarity constant for unit-range intensities (Xue et al.
+/// 2014: c = 0.0026; libgmsd's 170 is the same constant on 0..255).
+const GMS_C_UNIT: f64 = 0.0026;
+
+/// `(sample std, mean)` of the gradient-magnitude-similarity map of one
+/// plane pair at its native resolution: Prewitt/3 in x and y with zero
+/// padding outside the plane (GMSD's `conv2(…, 'same')`), `g = |∇|`,
+/// `q = (2·g_s·g_d + c) / (g_s² + g_d² + c)`. Research-only scalar code.
+fn gms_std_mean(sp: &[f32], dp: &[f32], w: usize, h: usize) -> (f64, f64) {
+    let at = |p: &[f32], x: isize, y: isize| -> f64 {
+        if x < 0 || y < 0 || x >= w as isize || y >= h as isize {
+            0.0
+        } else {
+            p[y as usize * w + x as usize] as f64
+        }
+    };
+    let grad = |p: &[f32], x: isize, y: isize| -> f64 {
+        let hx = (at(p, x - 1, y + 1) + at(p, x, y + 1) + at(p, x + 1, y + 1))
+            - (at(p, x - 1, y - 1) + at(p, x, y - 1) + at(p, x + 1, y - 1));
+        let hy = (at(p, x + 1, y - 1) + at(p, x + 1, y) + at(p, x + 1, y + 1))
+            - (at(p, x - 1, y - 1) + at(p, x - 1, y) + at(p, x - 1, y + 1));
+        ((hx * hx + hy * hy) / 9.0).sqrt()
+    };
+    let (mut s1, mut s2) = (0.0f64, 0.0f64);
+    for y in 0..h as isize {
+        for x in 0..w as isize {
+            let g1 = grad(sp, x, y);
+            let g2 = grad(dp, x, y);
+            let q = (2.0 * g1 * g2 + GMS_C_UNIT) / (g1 * g1 + g2 * g2 + GMS_C_UNIT);
+            let e = 1.0 - q;
+            s1 += e;
+            s2 += e * e;
+        }
+    }
+    let n = (w * h) as f64;
+    if n < 2.0 {
+        return (0.0, 1.0 - s1 / n.max(1.0));
+    }
+    let var = ((s2 - s1 * s1 / n) / (n - 1.0)).max(0.0);
+    (var.sqrt(), 1.0 - s1 / n)
+}
+
+/// Sample standard deviation of one materialized map, f64 accumulation.
+fn map_std(m: &[f32]) -> f64 {
+    let n = m.len() as f64;
+    if n < 2.0 {
+        return 0.0;
+    }
+    let mean = m.iter().map(|&v| v as f64).sum::<f64>() / n;
+    let ss = m
+        .iter()
+        .map(|&v| {
+            let d = v as f64 - mean;
+            d * d
+        })
+        .sum::<f64>();
+    (ss / (n - 1.0)).sqrt()
 }
 
