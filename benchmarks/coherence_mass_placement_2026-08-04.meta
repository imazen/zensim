#
# COMMAND (per bake, 50 bakes):
#   bake_contrib --bake <bake.bin> --corpus cid22:<regime-native>:-:1 \
#                --out ~/tmp/coh/contrib/<name>.tsv
#   then:
#   scripts/v_next/coherence_mass_analysis.py \
