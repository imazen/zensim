//! TENXPROBE (campaign appendix Y, A-Y4; worktree-local): single-image RD
//! probe cell for EXTERNAL per-superblock steering — encodes one PNG either
//! plain or with a `sb_q_scale` map derived from a zensim attribution-density
//! grid (`zensim avif_sb_hints` TSV), decodes the result, and prints a stats
//! line. The zensim→q_scale POLICY lives here (probe-side):
//!
//!   w_sb  = max(mean_density_sb, eps)         (positive = damaged)
//!   q_sb  = clamp((w_sb / geomean)^(-strength/2), lo, hi)
//!
//! geomean normalization ⇒ log-mean-zero map (≈rate-neutral); damaged
//! blocks get q_scale < 1 (finer quantization, more bits).
//!
//! Usage:
//!   sb_hints_cell <in.png> <out_prefix> <quality> <speed> single
//!   sb_hints_cell <in.png> <out_prefix> <quality> <speed> neutral
//!   sb_hints_cell <in.png> <out_prefix> <quality> <speed> hinted <hints.tsv> [strength] [lo] [hi]
//!
//! Writes `<out_prefix>.avif` + `<out_prefix>.png` (decoded). Stdout:
//!   mode<TAB>bytes<TAB>enc_ms<TAB>map_min<TAB>map_max

use almost_enough::{StopToken, Unstoppable};
use imgref::ImgVec;
use rgb::Rgb;
use zenavif::{EncoderConfig, encode_rgb8};

fn load_png_rgb(path: &std::path::Path) -> ImgVec<Rgb<u8>> {
    let img = image::open(path)
        .unwrap_or_else(|e| panic!("open {}: {e}", path.display()))
        .to_rgb8();
    let (w, h) = (img.width() as usize, img.height() as usize);
    let pixels: Vec<Rgb<u8>> = img
        .pixels()
        .map(|p| Rgb {
            r: p.0[0],
            g: p.0[1],
            b: p.0[2],
        })
        .collect();
    ImgVec::new(pixels, w, h)
}

/// Parse the `avif_sb_hints` TSV → per-SB mean densities + grid dims.
fn load_hints(path: &str) -> (Vec<f64>, usize, usize, usize, usize, usize) {
    let text = std::fs::read_to_string(path).expect("read hints tsv");
    let mut lines = text.lines();
    let header = lines.next().expect("header");
    let h: Vec<usize> = header
        .trim_start_matches('#')
        .split_whitespace()
        .map(|t| t.parse().expect("header num"))
        .collect();
    let (w, ih, block, cols, rows) = (h[0], h[1], h[2], h[3], h[4]);
    let mut vals = Vec::with_capacity(cols * rows);
    for line in lines {
        for tok in line.split('\t') {
            vals.push(tok.parse::<f64>().expect("density"));
        }
    }
    assert_eq!(vals.len(), cols * rows, "grid size mismatch");
    (vals, w, ih, block, cols, rows)
}

fn map_to_q_scale(means: &[f64], strength: f64, lo: f64, hi: f64) -> Box<[f32]> {
    let max_m = means.iter().cloned().fold(0.0f64, f64::max);
    let eps = (max_m * 1e-4).max(1e-30);
    let w: Vec<f64> = means.iter().map(|&m| m.max(eps)).collect();
    let log_gm = w.iter().map(|v| v.ln()).sum::<f64>() / w.len() as f64;
    let gm = log_gm.exp();
    w.iter()
        .map(|&v| ((v / gm).powf(-strength / 2.0).clamp(lo, hi)) as f32)
        .collect::<Vec<f32>>()
        .into_boxed_slice()
}

fn main() {
    let args: Vec<String> = std::env::args().collect();
    if args.len() < 6 {
        eprintln!(
            "usage: sb_hints_cell <in.png> <out_prefix> <quality> <speed> \
             single|neutral|hinted [hints.tsv] [strength] [lo] [hi]"
        );
        std::process::exit(2);
    }
    let input = std::path::Path::new(&args[1]);
    let out_prefix = &args[2];
    let quality: f32 = args[3].parse().expect("quality");
    let speed: u8 = args[4].parse().expect("speed");
    let mode = args[5].as_str();

    let img = load_png_rgb(input);
    let (w, h) = (img.width(), img.height());
    let sb_cols = w.div_ceil(64);
    let sb_rows = h.div_ceil(64);

    let (map, mmin, mmax): (Option<Box<[f32]>>, f32, f32) = match mode {
        "single" => (None, 1.0, 1.0),
        "neutral" => (
            Some(vec![1.0f32; sb_cols * sb_rows].into_boxed_slice()),
            1.0,
            1.0,
        ),
        "hinted" => {
            let hints_path = args.get(6).expect("hinted needs hints.tsv");
            let strength: f64 = args.get(7).map(|s| s.parse().unwrap()).unwrap_or(1.0);
            let lo: f64 = args.get(8).map(|s| s.parse().unwrap()).unwrap_or(0.5);
            let hi: f64 = args.get(9).map(|s| s.parse().unwrap()).unwrap_or(2.0);
            let (means, hw, hh, block, cols, rows) = load_hints(hints_path);
            assert_eq!((hw, hh), (w, h), "hints/image size mismatch");
            assert_eq!(block, 64, "SB hints must be 64px grid");
            assert_eq!((cols, rows), (sb_cols, sb_rows), "grid mismatch");
            let q = map_to_q_scale(&means, strength, lo, hi);
            let mn = q.iter().cloned().fold(f32::INFINITY, f32::min);
            let mx = q.iter().cloned().fold(f32::NEG_INFINITY, f32::max);
            (Some(q), mn, mx)
        }
        other => panic!("unknown mode {other}"),
    };

    let config = EncoderConfig::new()
        .quality(quality)
        .speed(speed)
        .bit_depth(zenavif::EncodeBitDepth::Eight)
        .chroma_subsampling(zenavif::EncodeChromaSubsampling::Yuv444)
        .with_sb_q_scale(map);
    let stop = StopToken::new(Unstoppable);

    let t0 = std::time::Instant::now();
    let enc = encode_rgb8(img.as_ref(), &config, stop).expect("encode");
    let ms = t0.elapsed().as_secs_f64() * 1000.0;
    let avif_path = format!("{out_prefix}.avif");
    std::fs::write(&avif_path, &enc.avif_file).expect("write avif");

    // Decode round-trip for the independent judges.
    let decoded = zenavif::decode(&enc.avif_file).expect("decode");
    let dec_img = decoded
        .try_as_imgref::<Rgb<u8>>()
        .expect("decoded as RGB8 imgref");
    let mut png = image::RgbImage::new(w as u32, h as u32);
    for (y, row) in dec_img.rows().enumerate() {
        for (x, px) in row.iter().enumerate() {
            png.put_pixel(x as u32, y as u32, image::Rgb([px.r, px.g, px.b]));
        }
    }
    png.save(format!("{out_prefix}.png")).expect("write png");

    println!(
        "{mode}\t{}\t{ms:.1}\t{mmin:.4}\t{mmax:.4}",
        enc.avif_file.len()
    );
}
